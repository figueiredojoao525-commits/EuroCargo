# ─────────────────────────────────────────────────────────────
# EuroCargo — frontend environment variables (Vite)
# Copy this file to `.env` and fill in the values.
# Only PUBLIC values belong here: everything prefixed with VITE_
# is embedded in the browser bundle.
# NEVER put the Supabase service_role key or payment secrets here.
# ─────────────────────────────────────────────────────────────

# Supabase project URL and PUBLIC key
# Supabase dashboard → Project Settings → API Keys
#   - the "publishable" key (sb_publishable_...) → VITE_SUPABASE_PUBLISHABLE_KEY
#   - older projects may use the legacy "anon" key (eyJ...) → VITE_SUPABASE_ANON_KEY
# Never the "secret" (sb_secret_...) or "service_role" key: the app refuses them.
# Check the connection with: npm run check:supabase
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Legacy alternative, only read when VITE_SUPABASE_PUBLISHABLE_KEY is empty:
# VITE_SUPABASE_ANON_KEY=

# Public contact details shown on the website (optional)
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
# WhatsApp business numbers (public), international format, digits only.
# Portugal / Spain: the site picks the customer's country (account country, else
# site language pt/es) and offers both when it cannot tell. Empty = hidden.
VITE_WHATSAPP_PT=
VITE_WHATSAPP_ES=

# Parts catalogue / assistant sources: local (default) or external.
# "external" calls the catalog-external / ai-assistant Edge Functions and falls
# back to local while they are not configured. See docs/catalog-and-ai.md.
VITE_CATALOG_PROVIDER=local
VITE_AI_PROVIDER=local

# ─────────────────────────────────────────────────────────────
# Server-side secrets (Supabase Edge Functions) — DO NOT put them
# in this file. Set them with the Supabase CLI:
#
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_...
#   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
#   supabase secrets set SITE_URL=https://your-domain.example
#
# Future integrations (only when contracted — see docs/catalog-and-ai.md):
#   supabase secrets set AI_PROVIDER=... AI_API_KEY=... [AI_MODEL=...]
#   supabase secrets set CATALOG_PROVIDER=... CATALOG_API_URL=... CATALOG_API_KEY=...
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are
# injected automatically into Edge Functions by Supabase.
# ─────────────────────────────────────────────────────────────
