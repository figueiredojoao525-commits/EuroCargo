# Edge Functions — server-side secrets (NEVER prefixed with VITE_, never in the website).
# Production: `supabase secrets set NAME=value`. Local `supabase functions serve`: copy this
# file to supabase/functions/.env (git-ignored).
# Leave everything EMPTY until a provider is contracted: with empty values the functions
# answer 503 and the website keeps using EuroCargo's own catalogue. No calls are made.

# Licensed / supplier catalogue (catalog-external, catalog-sync).
# CATALOG_PROVIDER = adapter name in supabase/functions/_shared/catalog/registry.ts
#   (eurocargo-feed = documented REST feed contract; tecdoc = prepared, not implemented)
CATALOG_PROVIDER=
CATALOG_API_URL=
CATALOG_API_KEY=

# AI provider for the assistant (ai-assistant). Interprets requests only; never invents data.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Payments (create-checkout, payment-webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SITE_URL=
